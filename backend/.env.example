# Never commit a real key. Copy this file to backend/.env for local server development,
# or set the values in your backend host's secret/environment settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Comma-separated browser origins allowed to call this backend.
# Leave empty for the bundled Electron app and same-origin requests.
JARVIS_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,https://armahjudah93-hue.github.io

# A bounded local router keeps the five approved tools usable when a model key is absent.
# It never interprets arbitrary code or enables Mac automation.
JARVIS_ALLOW_LOCAL_FALLBACK=true
PORT=8787
